{
  "name": "@jlbyte/consolebox",
  "version": "1.0.0",
  "description": "Dev Console in HTML",
  "keywords": [
    "console",
    "console-html",
    "console-playground",
    "console-app"
  ],
  "author": "jlongyam",
  "license": "MIT",
  "repository": "https://github.com/jlongyam/consoleBox",
  "homepage": "https://jlongyam.github.io/consoleBox/",
  "devDependencies": {
    "@jlbyte/js": "^1.0.2"
  },
  "dependencies": {
    "@jlbyte/ansi": "^1.2.3"
  },
  "main": "dist/console.cjs",
  "module": "dist/console.mjs",
  "jsdelivr": "dist/console.js",
  "exports": {
    ".": {
      "types": "./dist/console.d.mts",
      "import": "./dist/console.mjs",
      "require": "./dist/console.cjs"
    }
  },
  "files": [
    "./README.md",
    "./LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "js build ./src/console.mjs ./dist -p ./package.json -f es,cjs,iife -e @jlbyte/ansi -a ./src/console.css"
  }
}